// Prisma 7: as URLs do banco ficam em prisma.config.ts (CLI/migrations, DIRECT_URL)
// e em src/lib/prisma.ts (app, DATABASE_URL com pooler), não aqui.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Modelos do adapter Prisma do Auth.js

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  notes         Note[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Notas

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("Sem título")
  content   Json
  parentId  String?
  folder    String?
  favorite  Boolean  @default(false)
  links     String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Note?  @relation("NoteChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Note[] @relation("NoteChildren")

  @@index([userId])
  @@index([userId, parentId])
  @@index([userId, updatedAt])
}
