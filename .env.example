# Neon — Postgres (região sa-east-1)
# Connection string COM pooling (host contém "-pooler") — usada pelo app
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# Connection string SEM pooling (host sem "-pooler") — usada pelo Prisma nas migrations
DIRECT_URL="postgresql://USUARIO:SENHA@HOST.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js — segredo para assinar sessões/tokens. Gere com: npx auth secret
AUTH_SECRET="GERE_UM_SEGREDO_ALEATORIO"

# Login com GitHub — https://github.com/settings/developers (OAuth App)
# Callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="SEU_CLIENT_ID_DO_GITHUB"
AUTH_GITHUB_SECRET="SEU_CLIENT_SECRET_DO_GITHUB"

# Login com Google — https://console.cloud.google.com/apis/credentials (OAuth client ID)
# Callback: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="SEU_CLIENT_ID_DO_GOOGLE"
AUTH_GOOGLE_SECRET="SEU_CLIENT_SECRET_DO_GOOGLE"

# Só para testes (npm test): branch "dev" do Neon, conexão direta (sem pooler).
# NUNCA use a URL de produção aqui — os testes criam e apagam dados.
TEST_DATABASE_URL="postgresql://USUARIO:SENHA@HOST-DO-BRANCH-DEV.sa-east-1.aws.neon.tech/neondb?sslmode=require"
